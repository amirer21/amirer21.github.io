---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages_for_sitemap = site.html_pages | where_exp: "item", "item.sitemap != false" %}
  {% for page in pages_for_sitemap %}
    {% unless page.url contains '/404' or page.url contains '/assets/' or page.url == '/sitemap.xml' %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
    {% endunless %}
  {% endfor %}

  {% assign posts_for_sitemap = site.posts | where_exp: "item", "item.sitemap != false" %}
  {% for post in posts_for_sitemap %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}

  {% for collection in site.collections %}
    {% unless collection.label == 'posts' %}
      {% assign docs_for_sitemap = collection.docs | where_exp: "item", "item.sitemap != false" %}
      {% for doc in docs_for_sitemap %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
    <lastmod>{{ doc.date | default: site.time | date_to_xmlschema }}</lastmod>
  </url>
      {% endfor %}
    {% endunless %}
  {% endfor %}
</urlset>
